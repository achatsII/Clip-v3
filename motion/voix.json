 "cues": [
  {
   "id": "v01",
   "text": "Jacques connaît sa machine mieux que personne.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-45-55-249-i56aux.wav",
   "gap_after": 0.35
  },
  {
   "id": "v02",
   "text": "Dans un an, il prend sa retraite.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-45-59-273-q9uv6m.wav",
   "gap_after": 0.4
  },
  {
   "id": "v03",
   "text": "Et d'ici 2030, de vingt à trente pour cent des technologues partiront aussi.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-04-946-gp84nm.wav",
   "gap_after": 0.35,
   "speech": "Et d'ici deux-mille-trente, de vingt à trente pour cent des technologues partiront aussi."
  },
  {
   "id": "v04",
   "text": "Leur savoir-faire n'est écrit nulle part.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-09-409-70a496.wav",
   "gap_after": 1.2
  },
  {
   "id": "v05",
   "text": "Voici Clip.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-45-30-763-gv8a09.wav",
   "gap_after": 0.6,
   "speech": "Voici… Clip."
  },
  {
   "id": "v06",
   "text": "Filmez l'expert pendant qu'il explique. Clip enregistre tout, sur le téléphone.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-15-327-hczt11.wav",
   "gap_after": 0.35
  },
  {
   "id": "v07",
   "text": "Ajoutez des photos, une note vocale, ou vos vieilles procédures en PDF et en Word.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-33-940-6lwh5w.wav",
   "gap_after": 0.35,
   "speech": "Ajoutez des photos, une note vocale, ou vos vieilles procédures en P-D-F et en Word."
  },
  {
   "id": "v08",
   "text": "Puis, d'un seul bouton, l'IA rédige l'instruction de travail.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-50-37-556-t9x88m.wav",
   "gap_after": 0.35,
   "speech": "Puis, d'un seul bouton, l'I-A rédige l'instruction de travail."
  },
  {
   "id": "v09",
   "text": "Une action par étape, le bon extrait vidéo, les mises en garde au bon moment.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-47-906-u4bu4p.wav",
   "gap_after": 0.6
  },
  {
   "id": "v10",
   "text": "Retouchez d'un mot. Annotez d'un clic. Traduisez en quelques secondes.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-46-54-464-4dgujg.wav",
   "gap_after": 0.5
  },
  {
   "id": "v11",
   "text": "Et vos anciennes instructions? Déposez-les par dizaines, elles ressortent modernisées.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-51-35-565-71ly00.wav",
   "gap_after": 0.6
  },
  {
   "id": "v12",
   "text": "Faites-la approuver, puis déployez-la au poste, sur une tablette ou par code QR, sans compte.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-47-15-500-5qeea6.wav",
   "gap_after": 0.35,
   "speech": "Faites-la approuver, puis déployez-la au poste, sur une tablette ou par code Q-R, sans compte."
  },
  {
   "id": "v13",
   "text": "L'opérateur suit chaque étape, l'écoute à voix haute, et signale ce qui n'est pas clair.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-48-08-780-mvx0hn.wav",
   "gap_after": 0.6
  },
  {
   "id": "v14",
   "text": "Et d'un clic, elle s'exporte en PDF.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-50-50-177-7ghtaq.wav",
   "gap_after": 0.7,
   "speech": "Et d'un clic, elle s'exporte en P-D-F."
  },
  {
   "id": "v15",
   "text": "Clip. Le savoir-faire de vos experts, au poste, en quelques minutes.",
   "url": "https://ii-file.tor1.cdn.digitaloceanspaces.com/Audio-IA/tts-gemini-2026-11-12T16-47-36-733-2gal1x.wav",
   "gap_after": 0.5
