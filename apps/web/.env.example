# Copiez ce fichier en .env.local pour le développement. Rien de secret ici, sauf ABLY_KEY.

# Gateway Octopus (QA par défaut).
NEXT_PUBLIC_GATEWAY_URL=https://qa.gateway.intelligenceindustrielle.com

# Identifiant de connexion à la Gateway. « html » tant que l'application « clip-v3 » n'y est pas
# enregistrée ; les données restent cloisonnées par le champ json_data.app_identifier = « clip-v3 ».
NEXT_PUBLIC_APP_IDENTIFIER=html

# Inscription en libre-service (création de compte sur /connexion). À « true » seulement quand
# l'application enregistrée à la Gateway l'accepte.
NEXT_PUBLIC_SELF_SERVICE=false

# Facturation v2 (plans, crédits, paywall). Éteinte : l'app fonctionne comme sans facturation et
# l'IA passe par /api/v4/assistant/ask. Allumée seulement là où les routes /api/v2/billing répondent.
NEXT_PUBLIC_BILLING_V2=false
# Crédits par dollar canadien de coût réel de l'IA : la valeur se règle dans Vercel, jamais ici.
# Obligatoire dès que NEXT_PUBLIC_BILLING_V2 est allumé (sans elle, l'IA facturée refuse).
NEXT_PUBLIC_AI_CREDIT_RATE=

# Feature toggles servis à l'app et à la coquille mobile par GET /api/config (JSON fusionné sur
# les valeurs par défaut). Ex. : {"voiceAssistant":false}
CLIP_TOGGLES=

# Mise à jour forcée de la coquille mobile : contrainte semver des versions à bloquer.
# Ex. : <1.2.0  (vide = personne n'est bloqué)
CLIP_FORCE_UPDATE_IOS=
CLIP_FORCE_UPDATE_ANDROID=
CLIP_STORE_URL_IOS=
CLIP_STORE_URL_ANDROID=

# Réservé au temps réel entre appareils (écran TV). Secret serveur : jamais en NEXT_PUBLIC_.
ABLY_KEY=
