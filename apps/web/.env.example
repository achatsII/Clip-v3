# Copiez ce fichier en .env.local pour le développement. Rien de secret ici, sauf ABLY_KEY,
# SANDBOXES_CLE et SESSION_SECRET.

# Gateway Octopus (QA par défaut).
NEXT_PUBLIC_GATEWAY_URL=https://qa.gateway.intelligenceindustrielle.com

# Identifiant de connexion à la Gateway. « html » tant que l'application « clip-v3 » n'y est pas
# enregistrée ; les données restent cloisonnées par le champ json_data.app_identifier = « clip-v3 ».
NEXT_PUBLIC_APP_IDENTIFIER=html

# Inscription en libre-service (création de compte sur /connexion). À 1 seulement quand l'application
# enregistrée à la Gateway l'accepte ; toute autre valeur l'éteint. Allumée, le bouton principal du site
# devient « Essayer gratuitement » (sinon « Réserver une démo ») et les forfaits mènent à l'inscription.
NEXT_PUBLIC_SELF_SERVICE=0

# Facturation v2 (plans, crédits, paywall). À 1 pour l'allumer ; toute autre valeur l'éteint : l'app
# fonctionne comme sans facturation et l'IA passe par /api/v4/assistant/ask. Allumée seulement là où
# les routes /api/v2/billing répondent. Allumée, le forfait choisi sur le site s'ouvre, présélectionné,
# sur /reglages/abonnement après l'inscription.
NEXT_PUBLIC_BILLING_V2=0

# Le site public (/, /en) : son adresse pour les canoniques, le hreflang, le plan du site et les images
# Open Graph (défaut : https://clip-v3.vercel.app).
NEXT_PUBLIC_SITE_URL=https://clip-v3.vercel.app

# Le compte HubSpot du site : suivi chargé seulement après « Accepter » dans la bannière des témoins
# (Loi 25). Vide : aucun suivi.
NEXT_PUBLIC_HUBSPOT_ID=3429410

# Feature toggles servis à l'app et à la coquille mobile par GET /api/config (JSON fusionné sur
# les valeurs par défaut). Ex. : {"voiceAssistant":false}
CLIP_TOGGLES=

# Mise à jour forcée de la coquille mobile : contrainte semver des versions à bloquer.
# Ex. : <1.2.0  (vide = personne n'est bloqué)
CLIP_FORCE_UPDATE_IOS=
CLIP_FORCE_UPDATE_ANDROID=
CLIP_STORE_URL_IOS=
CLIP_STORE_URL_ANDROID=

# Espace Découvrir (/decouvrir : les vidéos et le conseiller, pour les prospects ; docs/DECOUVRIR.md).
# Serveur seulement, jamais en NEXT_PUBLIC_. Absente ou « ouvert » : l'espace est public ; « sandboxes » :
# l'accès passe par Sandboxes et le suivi y part. Lue au build : la changer, c'est redéployer.
DECOUVRIR_ACCES=
# L'API de Sandboxes (QA : https://sandboxes-gamma.vercel.app) et la clé de Clip (Sandboxes › Produits).
SANDBOXES_URL=
SANDBOXES_CLE=
# L'application des prospects à la Gateway (vide : « sandboxes »).
SANDBOXES_APP=
# La Gateway des comptes des prospects (production : https://gateway.intelligenceindustrielle.com) ;
# vide : celle de NEXT_PUBLIC_GATEWAY_URL.
DECOUVRIR_GATEWAY_URL=
# Scelle le cookie de l'espace (32 caractères aléatoires ou plus : openssl rand -base64 36). Secret serveur.
SESSION_SECRET=

# Réservé au temps réel entre appareils (écran TV). Secret serveur : jamais en NEXT_PUBLIC_.
ABLY_KEY=
