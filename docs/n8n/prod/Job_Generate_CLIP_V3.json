        320
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst err = item.error || {};\nconst message = err.message || err.description || 'workflow_error';\nconst now = new Date().toISOString();\nreturn [{ json: { status: 'failed', stage: 'failed', steps: ['started', 'analyze', 'failed'], heartbeatAt: now, finishedAt: now, result: null, error: { message: String(message).slice(0, 500), details: null } } }];"
      }
    },
    {
      "name": "Shape analysis result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        128
      ],
      "parameters": {
        "jsCode": "const run = $input.first().json || {};\nconst results = run.results || {};\nconst b = run.billing && typeof run.billing === 'object' ? run.billing : {};\nconst cad = Number(b.costs && b.costs.cad);\nconst billing = Number.isFinite(cad) ? { costs: { cad }, model: b.model || results.model || null, usage: b.usage || null } : null;\nconst now = new Date().toISOString();\n// Même lecture que sur l'appareil (aiApi.ask, CLIP V3) : parsed_json, sinon la réponse texte sans\n// ses balises de code quand la requête a un schéma.\nconst ask = $('Start CLIP V3 job').first().json.ask || {};\nlet parsed = results.parsed_json && typeof results.parsed_json === 'object' ? results.parsed_json : null;\nif (!parsed && ask.json_schema && typeof results.assistant_response === 'string') {\n  try { parsed = JSON.parse(results.assistant_response.replace(/^```(?:json)?\\s*|\\s*```$/g, '')); } catch (e) { parsed = null; }\n}\nconst failed = run.success === false || !!results.error;\nif (!failed && parsed && typeof parsed === 'object') {\n  return [{ json: { status: 'completed', stage: 'done', steps: ['started', 'analyze', 'completed'], heartbeatAt: now, finishedAt: now, error: null, result: { json: parsed, model: results.model || null, billing, skippedFiles: Array.isArray(run.skipped_files) ? run.skipped_files : [] } } }];\n}\nconst code = results.error || (run.success === false ? 'ai_error' : 'no_result');\nreturn [{ json: { status: 'failed', stage: 'failed', steps: ['started', 'analyze', 'failed'], heartbeatAt: now, finishedAt: now, result: billing ? { billing } : null, error: { message: String(code).slice(0, 500), details: results.error_details ? String(results.error_details).slice(0, 2000) : null } } }];"
      }
    },
