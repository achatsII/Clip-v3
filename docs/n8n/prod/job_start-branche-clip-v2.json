      "parameters": {
        "jsCode": "// Branche clip-v2 : la réponse immédiate. Le travail continue dans Job_Generate_CLIP_V2.\nlet insertedId = null;\ntry {\n  insertedId = $('Post Job CLIP V2').first().json.results[0].inserted_id;\n} catch (e) {}\n\nreturn {\n  json: insertedId\n    ? { success: true, message: \"L'analyse a démarré en arrière-plan.\", job_status: 'processing', record_id: insertedId }\n    : { success: false, message: \"Le document de suivi n'a pas été créé.\", job_status: 'failed', record_id: null }\n};"
