      "parameters": {
        "jsCode": "// Le résultat de Job_Generate_CLIP_V2 (ou son échec), ajouté au document clip_job.\nconst base = $('CLIP V2 job base').first().json.base;\nconst out = $input.first().json || {};\nconst now = new Date().toISOString();\nconst steps = (Array.isArray(base.steps) ? base.steps : ['started']).filter((s) => !['analyze', 'completed', 'failed'].includes(s));\nif (out.status === 'completed' || out.status === 'failed') {\n  return [{ json: { json_data: { ...base, ...out, steps: [...steps, 'analyze', out.status] } } }];\n}\nconst raw = out.error && typeof out.error === 'object' ? out.error.message : out.error;\nconst message = String(raw || 'analysis_failed').slice(0, 500);\nreturn [{ json: { json_data: { ...base, status: 'failed', stage: 'failed', steps: [...steps, 'analyze', 'failed'], heartbeatAt: now, finishedAt: now, result: null, error: { message, details: null } } } }];"
      }
