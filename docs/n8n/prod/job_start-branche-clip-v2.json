      "parameters": {
        "jsCode": "// Deuxième passage de la branche clip-v2 : le document clip_job créé au premier passage, lu avec\n// les droits de l'appelant. La route PATCH reçoit tout json_data : chaque écriture repart de ce\n// document, comme Job_Analyse_CLIP (V1).\nconst data = $('When Executed by Another Workflow').first().json.data || {};\nconst read = $input.first().json || {};\nconst prev = read.result && read.result.json_data && typeof read.result.json_data === 'object' ? read.result.json_data : null;\nif (!prev) throw new Error('clip_job introuvable : ' + String(data.jobId || ''));\n// Déjà terminé (un nouvel essai, un double appel) : rien à refaire.\nif (prev.status && prev.status !== 'running') return [];\nconst base = { app_identifier: $('When Executed by Another Workflow').first().json.appIdentifier, kind: 'generation', instructionId: data.instructionId ?? null, operation: data.operation ?? null, ...prev };\nconst steps = (Array.isArray(base.steps) ? base.steps : ['started']).filter((s) => s !== 'analyze');\nreturn [{ json: { base, analyzing: { ...base, stage: 'analyze', steps: [...steps, 'analyze'], heartbeatAt: new Date().toISOString() } } }];"
      }
    },
